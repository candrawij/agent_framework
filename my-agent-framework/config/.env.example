# =======================================
# Agent Framework Environment Variables
# Copy to .env and fill in your values
# =======================================

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# OpenAI (opsional)
OPENAI_API_KEY=sk-...

# SerpAPI untuk web search (opsional)
SERPAPI_KEY=

# Tavily AI Search (opsional)
TAVILY_API_KEY=

# Ollama URL (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant Vector DB (opsional, untuk production memory)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ChromaDB (opsional)
CHROMA_PERSIST_DIR=./data/chroma

# API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Mobile gateway
MOBILE_APP_NAME=MyAgent
